# Copy this file to functions/.env.local (never commit .env.local to git)
# The emulator reads this file automatically.
#
# Either name works — the function checks both:
FOOTBALL_DATA_API_TOKEN=your_token_here
# VITE_FOOTBALL_DATA_TOKEN=your_token_here   ← also accepted as fallback

# syncOsmEvent — must match the API_SECRET_KEY the Discord bot (scripts/osm-bot.js) sends.
# In production this is set via `firebase functions:secrets:set EVENTS_API_SECRET_KEY`, NOT here.
EVENTS_API_SECRET_KEY=your_shared_secret_here
